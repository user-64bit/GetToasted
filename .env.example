# Postgres (used by docker-compose + apps)
# DATABASE_URL / REDIS_URL use localhost so host-side commands (pnpm db:migrate,
# pnpm dev) work. The compose api/worker services override these with the
# docker-internal hostnames at runtime — see docker-compose.yml.
POSTGRES_USER=gettoasted
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gettoasted
DATABASE_URL=postgresql://gettoasted:changeme@localhost:5433/gettoasted

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
JWT_SECRET=changeme_min_32_chars_random_string_here
NODE_ENV=production

# Helius
HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WEBHOOK_SECRET=your_webhook_secret

# CORS — your Vercel frontend URL
APP_URL=https://gettoasted.fun
CORS_ORIGIN=https://gettoasted.fun

# Auth
SIWS_DOMAIN=gettoasted.fun

# Scanner per-job ceilings. Defaults are tuned for typical recent-activity
# scans; bump for historical backfill of older sandwiches.
# MAX_SCAN_SIGNATURES=1000
# MAX_SCAN_SLOTS=200
# MAX_SCAN_DURATION_MS=60000
